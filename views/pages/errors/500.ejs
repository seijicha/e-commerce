<div style="text-align: center; padding: 4rem 1rem;">
  <span class="badge badge--danger" style="margin-bottom: 1rem;">Server Exception (500)</span>
  <h1 style="font-size: 3rem; margin-bottom: 1rem; color: var(--color-accent);">System Glitch</h1>
  <p style="color: var(--color-muted); max-width: 500px; margin: 0 auto 2rem; font-size: 1.1rem;">
    <%= typeof message !== 'undefined' && message ? message : 'An unexpected exception occurred on the server. The incident has been recorded.' %>
  </p>

  <% if (typeof stack !== 'undefined' && stack) { %>
    <div style="max-width: 800px; margin: 2rem auto; text-align: left; background-color: var(--color-surface); padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius); overflow-x: auto;">
      <h4 style="margin-bottom: 0.5rem; color: var(--color-warning);">Debug Trace (Development Mode):</h4>
      <pre style="font-size: 0.85rem; color: var(--color-muted);"><%= stack %></pre>
    </div>
  <% } %>

  <div style="display: flex; justify-content: center; gap: 1rem;">
    <a href="/" class="btn btn--primary">Return Home</a>
  </div>
</div>
