<div style="margin-bottom: 2rem;">
  <h1 style="font-size: 2.25rem; margin-bottom: 0.5rem;">Shopping Cart</h1>
  <p style="color: var(--color-muted);">Review your selected items before proceeding to secure checkout.</p>
</div>

<% if (!cart.isEmpty) { %>
  <div class="checkout-grid">
    <!-- Cart Items Table / List -->
    <div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Garment</th>
              <th>Size</th>
              <th>Unit Price</th>
              <th>Quantity</th>
              <th>Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% cart.items.forEach(function(item) { %>
              <tr data-cart-row data-item-id="<%= item.id %>" data-unit-price="<%= item.price %>">
                <td>
                  <div style="display: flex; align-items: center; gap: 1rem;">
                    <% if (item.image_path) { %>
                      <img src="<%= item.image_path %>" alt="<%= item.product_name %>" style="width: 50px; height: 60px; object-fit: cover; border-radius: var(--radius-sm);" />
                    <% } %>
                    <div>
                      <a href="/shop/<%= item.product_slug %>" style="font-weight: 600; color: inherit;">
                        <%= item.product_name %>
                      </a>
                      <% if (item.isOutOfStock) { %>
                        <p style="color: var(--color-danger); font-size: 0.75rem; margin-top: 2px;">
                          <%= item.stock > 0 ? 'Only ' + item.stock + ' available' : 'Currently sold out' %>
                        </p>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge badge--neutral"><%= item.size %></span>
                </td>
                <td><%= formatMoney(item.price) %></td>
                <td>
                  <form action="/cart/items/<%= item.id %>?_method=PATCH" method="POST" style="display: inline-block;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <div class="stepper" data-stepper>
                      <button type="button" class="stepper__btn" data-stepper-dec aria-label="Decrease">−</button>
                      <input
                        type="number"
                        name="quantity"
                        value="<%= item.quantity %>"
                        min="1"
                        max="<%= Math.min(99, item.stock) %>"
                        class="stepper__input"
                        data-stepper-input
                        onchange="this.form.submit()"
                      />
                      <button type="button" class="stepper__btn" data-stepper-inc aria-label="Increase">+</button>
                    </div>
                  </form>
                </td>
                <td style="font-weight: 700; color: var(--color-accent-alt);" data-line-total>
                  <%= formatMoney(item.lineTotal) %>
                </td>
                <td style="text-align: right;">
                  <form action="/cart/items/<%= item.id %>?_method=DELETE" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn btn--secondary btn--sm" title="Remove item">✕</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div style="margin-top: 1.5rem;">
        <a href="/shop" class="btn btn--secondary" style="display: inline-flex; align-items: center; gap: 0.4rem;">
          <svg class="icon icon--sm" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          <span>Continue Shopping</span>
        </a>
      </div>
    </div>

    <!-- Order Summary Card -->
    <div>
      <div class="card">
        <div class="card__header">
          <h3 style="font-size: 1.15rem;">Order Summary</h3>
        </div>
        <div class="card__body" style="display: flex; flex-direction: column; gap: 1rem;">
          <div style="display: flex; justify-content: space-between; color: var(--color-muted);">
            <span>Subtotal (<span data-cart-total-items><%= cart.totalItems %></span> items)</span>
            <span style="color: var(--color-text); font-weight: 600;" data-cart-subtotal><%= formatMoney(cart.subtotal) %></span>
          </div>
          <div style="display: flex; justify-content: space-between; color: var(--color-muted);">
            <span>Shipping</span>
            <span style="color: var(--color-success); font-weight: 600;">FREE (Standard)</span>
          </div>
          <div style="border-top: 1px solid var(--color-border); padding-top: 1rem; display: flex; justify-content: space-between; align-items: baseline;">
            <span style="font-size: 1.1rem; font-weight: 600;">Grand Total</span>
            <span style="font-family: var(--font-display); font-size: 1.6rem; font-weight: 700; color: var(--color-accent-alt);" data-cart-grand-total>
              <%= formatMoney(cart.total) %>
            </span>
          </div>

          <% if (cart.hasOutOfStock) { %>
            <div class="alert alert--error" style="margin-top: 1rem;">
              <span>Please adjust or remove items exceeding inventory stock before proceeding.</span>
            </div>
          <% } %>

          <a href="/checkout" class="btn btn--primary btn--lg btn--block <%= cart.hasOutOfStock ? 'disabled' : '' %>" style="margin-top: 1rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;">
            <span>Proceed to Checkout</span>
            <svg class="icon icon--sm" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
<% } else { %>
  <div style="text-align: center; padding: 4rem 1rem; background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg);">
    <h3 style="font-size: 1.5rem; margin-bottom: 0.5rem;">Your Cart is Empty</h3>
    <p style="color: var(--color-muted); margin-bottom: 2rem;">Discover our latest releases and find pieces that match your aesthetic.</p>
    <a href="/shop" class="btn btn--primary btn--lg">Explore the Catalog</a>
  </div>
<% } %>
