<div style="margin-bottom: 2rem;">
  <h1 style="font-size: 2.25rem; margin-bottom: 0.5rem;">Checkout</h1>
  <p style="color: var(--color-muted);">Enter your shipping address to finalize your order.</p>
</div>

<form action="/checkout" method="POST" data-checkout-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <div class="checkout-grid">
    <!-- Shipping Information -->
    <div>
      <div class="card" style="margin-bottom: 1.5rem;">
        <div class="card__header">
          <h3 style="font-size: 1.15rem;">1. Shipping Address</h3>
        </div>
        <div class="card__body">
          <div class="form-group">
            <label for="shipping_name" class="form-label">Recipient Full Name <span class="required">*</span></label>
            <input
              type="text"
              id="shipping_name"
              name="shipping_name"
              value="<%= typeof formData !== 'undefined' && formData.shipping_name ? formData.shipping_name : '' %>"
              class="form-input <%= (typeof errors !== 'undefined' && errors.shipping_name) ? 'form-input--error' : '' %>"
              required
            />
            <% if (typeof errors !== 'undefined' && errors.shipping_name) { %>
              <p class="form-error"><%= errors.shipping_name.msg %></p>
            <% } %>
          </div>

          <div class="form-group">
            <label for="shipping_phone" class="form-label">Contact Phone Number <span class="required">*</span></label>
            <input
              type="tel"
              id="shipping_phone"
              name="shipping_phone"
              value="<%= typeof formData !== 'undefined' && formData.shipping_phone ? formData.shipping_phone : '' %>"
              class="form-input <%= (typeof errors !== 'undefined' && errors.shipping_phone) ? 'form-input--error' : '' %>"
              placeholder="+63 9XX XXX XXXX"
              required
            />
            <% if (typeof errors !== 'undefined' && errors.shipping_phone) { %>
              <p class="form-error"><%= errors.shipping_phone.msg %></p>
            <% } %>
          </div>

          <div class="form-group">
            <label for="shipping_address" class="form-label">Delivery Street Address <span class="required">*</span></label>
            <textarea
              id="shipping_address"
              name="shipping_address"
              rows="3"
              class="form-textarea <%= (typeof errors !== 'undefined' && errors.shipping_address) ? 'form-input--error' : '' %>"
              placeholder="Unit / Floor, House Number, Street, Barangay"
              required
            ><%= typeof formData !== 'undefined' && formData.shipping_address ? formData.shipping_address : '' %></textarea>
            <% if (typeof errors !== 'undefined' && errors.shipping_address) { %>
              <p class="form-error"><%= errors.shipping_address.msg %></p>
            <% } %>
          </div>

          <div class="form-group">
            <label for="shipping_country" class="form-label">Country / Region <span class="required">*</span></label>
            <select
              id="shipping_country"
              name="shipping_country"
              class="form-select <%= (typeof errors !== 'undefined' && errors.shipping_country) ? 'form-input--error' : '' %>"
              required
            >
              <%
                const selectedCountry = typeof formData !== 'undefined' && formData.shipping_country ? formData.shipping_country : 'Philippines';
                const countries = [
                  'Philippines', 'United States', 'Japan', 'Germany', 'United Kingdom',
                  'Canada', 'Australia', 'Singapore', 'South Korea', 'France',
                  'Italy', 'Spain', 'Netherlands', 'Hong Kong', 'Taiwan',
                  'New Zealand', 'United Arab Emirates', 'Sweden', 'Switzerland', 'Norway'
                ];
              %>
              <% countries.forEach(function(c) { %>
                <option value="<%= c %>" <%= selectedCountry === c ? 'selected' : '' %>><%= c %></option>
              <% }); %>
            </select>
            <% if (typeof errors !== 'undefined' && errors.shipping_country) { %>
              <p class="form-error"><%= errors.shipping_country.msg %></p>
            <% } %>
          </div>

          <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem;">
            <div class="form-group">
              <label for="shipping_city" class="form-label">City / Municipality <span class="required">*</span></label>
              <input
                type="text"
                id="shipping_city"
                name="shipping_city"
                value="<%= typeof formData !== 'undefined' && formData.shipping_city ? formData.shipping_city : '' %>"
                class="form-input <%= (typeof errors !== 'undefined' && errors.shipping_city) ? 'form-input--error' : '' %>"
                required
              />
              <% if (typeof errors !== 'undefined' && errors.shipping_city) { %>
                <p class="form-error"><%= errors.shipping_city.msg %></p>
              <% } %>
            </div>

            <div class="form-group">
              <label for="shipping_postal_code" class="form-label">Postal / ZIP <span class="required">*</span></label>
              <input
                type="text"
                id="shipping_postal_code"
                name="shipping_postal_code"
                value="<%= typeof formData !== 'undefined' && formData.shipping_postal_code ? formData.shipping_postal_code : '' %>"
                class="form-input <%= (typeof errors !== 'undefined' && errors.shipping_postal_code) ? 'form-input--error' : '' %>"
                required
              />
              <% if (typeof errors !== 'undefined' && errors.shipping_postal_code) { %>
                <p class="form-error"><%= errors.shipping_postal_code.msg %></p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment Method -->
      <div class="card">
        <div class="card__header">
          <h3 style="font-size: 1.15rem;">2. Payment Method</h3>
        </div>
        <div class="card__body" style="display: flex; flex-direction: column; gap: 0.75rem;">
          <% const currentPayment = typeof formData !== 'undefined' && formData.payment_method ? formData.payment_method : 'cod'; %>

          <label for="payment_cod" style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; background-color: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: var(--radius); cursor: pointer;">
            <input type="radio" id="payment_cod" name="payment_method" value="cod" <%= currentPayment === 'cod' ? 'checked' : '' %> style="margin-top: 3px;" />
            <div>
              <span style="font-weight: 700; color: var(--color-text);">Cash on Delivery (COD)</span>
              <span style="display: block; font-size: 0.85rem; color: var(--color-muted); margin-top: 2px;">
                Pay securely in cash upon door delivery of your parcel.
              </span>
            </div>
          </label>

          <label for="payment_gcash" style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; background-color: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: var(--radius); cursor: pointer;">
            <input type="radio" id="payment_gcash" name="payment_method" value="gcash" <%= currentPayment === 'gcash' ? 'checked' : '' %> style="margin-top: 3px;" />
            <div>
              <span style="font-weight: 700; color: var(--color-text);">GCash e-Wallet</span>
              <span style="display: block; font-size: 0.85rem; color: var(--color-muted); margin-top: 2px;">
                Instant dispatch via GCash express scan to pay or direct mobile number transfer.
              </span>
            </div>
          </label>

          <label for="payment_bank" style="display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; background-color: var(--color-surface-hover); border: 1px solid var(--color-border); border-radius: var(--radius); cursor: pointer;">
            <input type="radio" id="payment_bank" name="payment_method" value="bank_transfer" <%= currentPayment === 'bank_transfer' ? 'checked' : '' %> style="margin-top: 3px;" />
            <div>
              <span style="font-weight: 700; color: var(--color-text);">Direct Bank Transfer</span>
              <span style="display: block; font-size: 0.85rem; color: var(--color-muted); margin-top: 2px;">
                Transfer directly via BDO, BPI, or UnionBank with automated wire verification.
              </span>
            </div>
          </label>

          <% if (typeof errors !== 'undefined' && errors.payment_method) { %>
            <p class="form-error"><%= errors.payment_method.msg %></p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Review Items & Totals -->
    <div>
      <div class="card">
        <div class="card__header">
          <h3 style="font-size: 1.15rem;">Order Review</h3>
        </div>
        <div class="card__body">
          <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem; max-height: 280px; overflow-y: auto; padding-right: 4px;">
            <% cart.items.forEach(function(item) { %>
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem;">
                <div>
                  <p style="font-weight: 600;"><%= item.product_name %></p>
                  <p style="color: var(--color-muted); font-size: 0.8rem;">
                    Size: <%= item.size %> &times; <%= item.quantity %>
                  </p>
                </div>
                <span style="font-weight: 600;"><%= formatMoney(item.lineTotal) %></span>
              </div>
            <% }); %>
          </div>

          <div style="display: flex; justify-content: space-between; color: var(--color-muted); margin-bottom: 0.5rem;">
            <span>Subtotal</span>
            <span id="checkout-subtotal" data-subtotal="<%= cart.subtotal %>" style="color: var(--color-text); font-weight: 600;"><%= formatMoney(cart.subtotal) %></span>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: flex-start; color: var(--color-muted); margin-bottom: 1rem;">
            <span>Shipping</span>
            <div id="checkout-shipping-display" style="text-align: right;">
              <% const fee = typeof shippingFee !== 'undefined' ? shippingFee : 0; %>
              <% if (fee === 0) { %>
                <span style="color: var(--color-success); font-weight: 600;">FREE</span>
                <span style="font-size: 0.78rem; color: var(--color-muted);">(Metro Manila)</span>
              <% } else { %>
                <span style="color: var(--color-text); font-weight: 600;"><%= formatMoney(fee) %></span>
                <span style="display: block; font-size: 0.75rem; color: var(--color-muted);"><%= typeof shippingLabel !== 'undefined' ? shippingLabel : '' %></span>
              <% } %>
            </div>
          </div>

          <div style="border-top: 1px solid var(--color-border); padding-top: 1rem; display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem;">
            <span style="font-size: 1.1rem; font-weight: 600;">Total Amount</span>
            <span id="checkout-total-display" style="font-family: var(--font-display); font-size: 1.6rem; font-weight: 700; color: var(--color-accent-alt);">
              <%= formatMoney(typeof checkoutTotal !== 'undefined' ? checkoutTotal : cart.total) %>
            </span>
          </div>

          <button type="submit" class="btn btn--primary btn--lg btn--block" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;">
            <span>Confirm & Place Order</span>
            <svg class="icon icon--sm" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</form>
