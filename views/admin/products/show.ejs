<div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-start;">
  <div>
    <a href="/admin/products" class="btn btn--secondary btn--sm" style="margin-bottom: 0.75rem; display: inline-flex; align-items: center; gap: 0.35rem;">
      <svg class="icon icon--sm" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      <span>Back to Products</span>
    </a>
    <h1 style="font-size: 2rem; margin-bottom: 0.25rem;"><%= product.name %></h1>
    <p style="color: var(--color-muted);">Slug: <code>/shop/<%= product.slug %></code></p>
  </div>
  <div style="display: flex; gap: 0.5rem; align-items: center;">
    <a href="/admin/products/<%= product.id %>/edit" class="btn btn--primary">Edit Product</a>
    <a href="/shop/<%= product.slug %>" target="_blank" class="btn btn--outline" style="display: inline-flex; align-items: center; gap: 0.35rem;">
      <span>View on Storefront</span>
      <svg class="icon icon--sm" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
    </a>
  </div>
</div>

<div class="product-detail">
  <div class="product-detail__image-box">
    <% if (product.image_path) { %>
      <img src="<%= product.image_path %>" alt="<%= product.name %>" class="product-detail__image" />
    <% } else { %>
      <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--color-muted);">
        No Image Available
      </div>
    <% } %>
  </div>

  <div class="product-detail__info">
    <div class="card">
      <div class="card__header">
        <h3 style="font-size: 1.15rem;">Product Specifications</h3>
      </div>
      <div class="card__body" style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <span style="color: var(--color-muted); font-size: 0.85rem;">Category:</span>
          <p><strong style="color: var(--color-text);"><%= product.category_name %></strong></p>
        </div>
        <div>
          <span style="color: var(--color-muted); font-size: 0.85rem;">Retail Price:</span>
          <p class="product-detail__price" style="font-size: 1.5rem;"><%= formatMoney(product.price) %></p>
        </div>
        <div>
          <span style="color: var(--color-muted); font-size: 0.85rem;">Status:</span>
          <p>
            <% if (product.is_published) { %>
              <span class="badge badge--success">Published</span>
            <% } else { %>
              <span class="badge badge--neutral">Draft (Hidden)</span>
            <% } %>
          </p>
        </div>
        <div>
          <span style="color: var(--color-muted); font-size: 0.85rem;">Description:</span>
          <p style="color: var(--color-muted); line-height: 1.6; margin-top: 0.25rem;"><%= product.description || 'No description provided.' %></p>
        </div>
      </div>
    </div>

    <!-- Sizing & Stock -->
    <div class="card">
      <div class="card__header">
        <h3 style="font-size: 1.15rem;">Variant Stock Breakdown</h3>
      </div>
      <div class="card__body">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Size</th>
                <th>Units in Stock</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% product.variants.forEach(function(v) { %>
                <tr>
                  <td><strong style="font-family: var(--font-display);"><%= v.size %></strong></td>
                  <td><%= v.stock %></td>
                  <td>
                    <% if (v.stock > 10) { %>
                      <span class="badge badge--success">In Stock</span>
                    <% } else if (v.stock > 0) { %>
                      <span class="badge badge--warning">Low Stock</span>
                    <% } else { %>
                      <span class="badge badge--danger">Sold Out</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
