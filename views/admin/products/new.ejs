<div style="margin-bottom: 2rem;">
  <a href="/admin/products" class="btn btn--secondary btn--sm" style="margin-bottom: 0.75rem; display: inline-flex; align-items: center; gap: 0.35rem;">
    <svg class="icon icon--sm" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
    <span>Back to Products</span>
  </a>
  <h1 style="font-size: 2rem; margin-bottom: 0.25rem;">Create New Product</h1>
  <p style="color: var(--color-muted);">Configure garment specifications, sizing variants, and upload imagery.</p>
</div>

<form action="/admin/products" method="POST" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <%- include('_form', { isEdit: false, product, categories, formData, errors }) %>
</form>
