<%# Reusable form field partial %>
<div class="form-group">
  <label for="<%= id %>" class="form-label">
    <%= label %>
    <% if (typeof required !== 'undefined' && required) { %>
      <span class="required">*</span>
    <% } %>
  </label>

  <% if (typeof type !== 'undefined' && type === 'textarea') { %>
    <textarea
      id="<%= id %>"
      name="<%= name %>"
      class="form-textarea <%= (typeof errors !== 'undefined' && errors[name]) ? 'form-input--error' : '' %>"
      rows="<%= typeof rows !== 'undefined' ? rows : 4 %>"
      <% if (typeof required !== 'undefined' && required) { %>required<% } %>
      <% if (typeof placeholder !== 'undefined') { %>placeholder="<%= placeholder %>"<% } %>
    ><%= typeof value !== 'undefined' ? value : '' %></textarea>
  <% } else { %>
    <input
      type="<%= typeof type !== 'undefined' ? type : 'text' %>"
      id="<%= id %>"
      name="<%= name %>"
      value="<%= typeof value !== 'undefined' ? value : '' %>"
      class="form-input <%= (typeof errors !== 'undefined' && errors[name]) ? 'form-input--error' : '' %>"
      <% if (typeof required !== 'undefined' && required) { %>required<% } %>
      <% if (typeof placeholder !== 'undefined') { %>placeholder="<%= placeholder %>"<% } %>
      <% if (typeof step !== 'undefined') { %>step="<%= step %>"<% } %>
      <% if (typeof min !== 'undefined') { %>min="<%= min %>"<% } %>
      <% if (typeof max !== 'undefined') { %>max="<%= max %>"<% } %>
    />
  <% } %>

  <% if (typeof errors !== 'undefined' && errors[name]) { %>
    <p class="form-error"><%= errors[name].msg %></p>
  <% } else if (typeof hint !== 'undefined' && hint) { %>
    <p class="form-hint"><%= hint %></p>
  <% } %>
</div>
