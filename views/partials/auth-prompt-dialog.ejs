<dialog id="auth-prompt-dialog" class="modal-dialog">
  <div class="modal-dialog__content">
    <div style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: 0.75rem;">
      <svg class="icon icon--md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-accent);" aria-hidden="true">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--color-text); margin: 0;">Login Required</h3>
    </div>

    <p id="auth-prompt-message" style="color: var(--color-muted); font-size: 0.95rem; line-height: 1.5; margin-bottom: 1.5rem;">
      Please log in first to access your Account.
    </p>

    <div style="display: flex; justify-content: flex-end; align-items: center; gap: 0.75rem;">
      <button type="button" id="auth-prompt-cancel" class="btn btn--secondary btn--sm">Cancel</button>
      <a href="/login" id="auth-prompt-confirm" class="btn btn--primary btn--sm">Log In</a>
    </div>
  </div>
</dialog>
