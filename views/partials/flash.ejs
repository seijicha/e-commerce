<% if (typeof flash !== 'undefined') { %>
  <% if (flash.success && flash.success.length > 0) { %>
    <% flash.success.forEach(function(msg) { %>
      <div class="alert alert--success" role="alert">
        <svg class="icon icon--sm" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span><%= msg %></span>
      </div>
    <% }); %>
  <% } %>

  <% if (flash.error && flash.error.length > 0) { %>
    <% flash.error.forEach(function(msg) { %>
      <div class="alert alert--error" role="alert">
        <svg class="icon icon--sm" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span><%= msg %></span>
      </div>
    <% }); %>
  <% } %>

  <% if (flash.info && flash.info.length > 0) { %>
    <% flash.info.forEach(function(msg) { %>
      <div class="alert alert--info" role="alert">
        <svg class="icon icon--sm" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        <span><%= msg %></span>
      </div>
    <% }); %>
  <% } %>
<% } %>
