<%
  const activePath = typeof currentPath !== 'undefined' ? currentPath : '';
  const currentUser = typeof user !== 'undefined' ? user : null;
  const token = typeof csrfToken !== 'undefined' ? csrfToken : '';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin Console — GlitchAttire' %></title>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/pages.css">
  <%- style %>
</head>
<body>
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="admin-sidebar__brand">
        <a href="/admin" class="brand-logo brand-logo--admin" aria-label="GlitchAttire Admin">
          <img src="/logo/logo.png" alt="GlitchAttire" class="brand-logo__img" />
          <span>ADMIN</span>
        </a>
      </div>

      <nav class="admin-sidebar__nav">
        <a href="/admin" class="admin-sidebar__link <%= activePath === '/admin' ? 'admin-sidebar__link--active' : '' %>">
          <svg class="icon icon--sm" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span>Dashboard</span>
        </a>
        <a href="/admin/products" class="admin-sidebar__link <%= activePath.startsWith('/admin/products') ? 'admin-sidebar__link--active' : '' %>">
          <svg class="icon icon--sm" viewBox="0 0 24 24"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"></path></svg>
          <span>Products</span>
        </a>
        <a href="/admin/categories" class="admin-sidebar__link <%= activePath.startsWith('/admin/categories') ? 'admin-sidebar__link--active' : '' %>">
          <svg class="icon icon--sm" viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
          <span>Categories</span>
        </a>
        <a href="/admin/orders" class="admin-sidebar__link <%= activePath.startsWith('/admin/orders') ? 'admin-sidebar__link--active' : '' %>">
          <svg class="icon icon--sm" viewBox="0 0 24 24"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          <span>Orders</span>
        </a>
        <a href="/admin/customers" class="admin-sidebar__link <%= activePath.startsWith('/admin/customers') ? 'admin-sidebar__link--active' : '' %>">
          <svg class="icon icon--sm" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span>Customers</span>
        </a>
      </nav>

      <div style="margin-top: auto; padding: var(--space-4); border-top: 1px solid var(--color-border);">
        <a href="/" target="_blank" class="btn btn--outline btn--sm btn--block" style="margin-bottom: var(--space-2); display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;">
          <span>Storefront</span>
          <svg class="icon icon--sm" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
        <form action="/admin/logout" method="POST">
          <input type="hidden" name="_csrf" value="<%= token %>" />
          <button type="submit" class="btn btn--secondary btn--sm btn--block">Log Out</button>
        </form>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <div>
          <h2 style="font-size: 1.15rem; font-weight: 600;"><%= typeof title !== 'undefined' ? title : 'Admin Console' %></h2>
        </div>
        <div style="display: flex; align-items: center; gap: 1rem;">
          <span style="font-size: 0.85rem; color: var(--color-muted);">
            Logged in as <strong style="color: var(--color-text);"><%= currentUser ? currentUser.name : 'Administrator' %></strong>
          </span>
        </div>
      </header>

      <main class="admin-content">
        <%- include('../partials/flash') %>
        <%- body %>
      </main>
    </div>
  </div>

  <%- include('../partials/confirm-delete') %>

  <script type="module" src="/js/main.js"></script>
  <%- script %>
</body>
</html>
